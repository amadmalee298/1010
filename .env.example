# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: used by admin scripts (inviting employees). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: local PostgreSQL for DB integration tests
TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres?host=/tmp
