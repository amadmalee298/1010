# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: used by admin scripts (inviting employees). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: local PostgreSQL for DB integration tests
TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres?host=/tmp
# Bill inbox (optional) — see docs/DEPLOYMENT.md "Bills via Telegram"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
GOOGLE_DRIVE_SCRIPT_URL=
GOOGLE_DRIVE_SCRIPT_SECRET=
